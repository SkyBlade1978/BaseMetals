{
  "multipart": [
    {
      "apply": {
        "model": "basemetals:block/tin_bars_post"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_side"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_cap"
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_side_alt"
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_cap_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_side_alt",
        "y": 90
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_cap",
        "y": 270
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_side",
        "y": 90
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "basemetals:block/tin_bars_cap_alt"
      }
    }
  ]
}